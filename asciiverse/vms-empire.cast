[0.001, "o", "\u001b(B\u001b[0;1m\u001b[37m\u001b[40man army has been completed at city 2831.\r\u001b[4d\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[K\u001b[30d\u001b[3;37H\u001b(B\u001b[0;1m\u001b[37m\u001b[40m54\r\u001b[30d\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[3;37H\u001b(B\u001b[0;1m\u001b[37m\u001b[40m445\u001b[4;94H\u001b[1K \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40m  \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40mS\u001b[21d\b4\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[39;49m\u001b[37m\u001b[40m\u001b[H\u001b[2J\u001b(B\u001b[0;1m\u001b[37m\u001b[40marmy at 2445:  moves = 1; hits = 1; func = none\u001b[2;89H User  Comp\u001b[3;89H    5     5\u001b[4;38H\u001b[1K \u001b[36m\u001b[40m..\u001b[32m\u001b[40m++++\u001b[36m\u001b[40m..\u001b[37m\u001b[40m\u001b[48X\u001b[95G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40m  \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40mS\u001b[5;38H\u001b[1K \u001b[36m\u001b[40m.\u001b[32m\u001b[40m++++++\u001b[36m\u001b[40m..\u001b[37m\u001b[40m\u001b[47X\u001b[95G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40m18\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40me\u001b[6;38H\u001b[1K \u001b[36m\u001b[40m.\u001b[32m\u001b[40m+\u001b[37m\u001b[40mO\u001b[32m\u001b[40m+++\u001b[37m\u001b[40mA\u001b[32m\u001b[40m+\u001b[36m\u001b[40m.\u001b[37m\u001b[40m\u001b[47X\u001b[95G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40m  \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40mc\u001b[7;38H\u001b[1K \u001b[36m\u001b[40m.\u001b[32m\u001b[40m+\u001b[6b\u001b[36m\u001b[40m..\u001b[37m\u001b[40m\u001b[46X\u001b[95G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b